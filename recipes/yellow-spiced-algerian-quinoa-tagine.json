      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "diced tomatoes",
      "amount": "1 can"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large stone bowl dolsot over medium heat.",
    "Add the ground cumin, ground coriander, turmeric, paprika, salt, and black pepper, and cook for 1 minute.",
    "Add the quinoa and cook for 1 minute, stirring constantly.",
    "Add the diced tomatoes and chicken broth, and bring to a boil.",
    "Reduce the heat to low, cover, and simmer for 20 minutes.",
    "Fluff the quinoa with a fork and serve hot.",
    "Garnish with fresh parsley or cilantro, if desired.",
    "Serve with lemon wedges on the side.",
    "Let it rest for 5 minutes before serving."
  ],
