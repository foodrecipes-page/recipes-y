      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the oil in a large pan over medium heat.",
    "Add the onion and cook until it is softened and lightly browned.",
    "Add the garlic and ginger and cook for 1 minute.",
    "Stir in the curry powder, turmeric, and cumin and cook for 1 minute.",
    "Add the coconut milk and bring the mixture to a simmer.",
    "Reduce the heat to low and let the curry simmer for 10 minutes.",
    "Stir in the grated cheese until it is melted and the curry is smooth.",
    "Season the curry with salt and pepper to taste.",
    "Serve the curry hot over rice or with naan bread."
  ],
