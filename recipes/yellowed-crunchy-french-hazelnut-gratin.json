{
  "title": "Yellowed Crunchy French Hazelnut Gratin",
  "description": "A rich and chewy French dish from Normandy featuring hazelnuts and ferment-kimchi, perfect for a low-carb friendly dinner",
  "cuisine": "French",
  "diet": [
    "low-carb"
  ],
  "meal": "dinner",
