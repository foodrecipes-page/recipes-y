      "amount": "2 tablespoons",
      "notes": "Thai or Indian style"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and sliced"
    },
    {
      "name": "potatoes",
      "amount": "2 medium",
      "notes": "peeled and diced"
    },
    {
      "name": "coconut milk",
      "amount": "1 can",
      "notes": "full fat"
    },
    {
      "name": "vegetable oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Heat the oil in a large pan over medium heat.",
    "Add the onion and cook until softened, about 5 minutes.",
    "Add the garlic and cook for 1 minute, until fragrant.",
    "Add the curry paste and cook for 1 minute, stirring constantly.",
    "Add the carrots and potatoes, and cook for 5 minutes, stirring occasionally.",
    "Pour in the coconut milk and bring to a simmer.",
    "Reduce the heat to low and cook, covered, until the vegetables are tender, about 15 minutes.",
    "Season with salt to taste.",
    "Serve the curry hot, garnished with chopped fresh herbs if desired."
  ],
