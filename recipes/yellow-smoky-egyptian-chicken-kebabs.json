{
  "title": "Yellow Smoky Egyptian Chicken Kebabs",
  "description": "A tangy and crunchy weeknight Egyptian dish featuring smoky paprika, perfect for a quick dinner",
  "cuisine": "Egyptian",
  "diet": [
    "gluten-free",
    "dairy-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "smoky paprika",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "binchotan charcoal",
      "amount": "1 cup",
      "notes": "for grilling"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat using binchotan charcoal for a smoky flavor",
    "In a large bowl, whisk together smoky paprika, lemon juice, olive oil, garlic, salt, and black pepper",
    "Add the chicken to the bowl and toss to coat with the marinade",
    "Thread the chicken onto skewers, leaving a small space between each piece",
    "Grill the chicken for 10-12 minutes, turning occasionally, until cooked through",
    "Serve the kebabs hot, garnished with fresh parsley or cilantro",
    "Let the kebabs rest for a few minutes before serving",
    "Serve with a side of tangy tahini sauce or yogurt sauce"
  ],
