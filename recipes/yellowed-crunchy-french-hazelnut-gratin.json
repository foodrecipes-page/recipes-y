    {
      "name": "hazelnuts",
      "amount": "1 cup",
      "notes": "chopped"
    },
    {
      "name": "ferment-kimchi",
      "amount": "1/2 cup",
      "notes": "chopped"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "gruyere cheese",
      "amount": "1 cup",
      "notes": "shredded"
    },
    {
      "name": "heavy cream",
      "amount": "1/2 cup"
    },
    {
      "name": "eggs",
      "amount": "2"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit",
    "In a large skillet, melt the butter over medium heat",
    "Add the chopped hazelnuts and cook until lightly toasted",
    "Add the chopped ferment-kimchi and cook for an additional 2 minutes",
    "In a large bowl, whisk together the heavy cream, eggs, salt, and black pepper",
    "Stir in the shredded gruyere cheese",
    "Add the toasted hazelnut and kimchi mixture to the bowl and stir until well combined",
    "Transfer the mixture to a terracotta dish and bake for 25 minutes",
    "Remove from the oven and let cool for 5 minutes before serving"
  ],
