    },
    {
      "name": "Coconut oil",
      "amount": "1/2 cup",
      "notes": ""
    },
    {
      "name": "Chopped cilantro",
      "amount": "optional",
      "notes": ""
    },
    {
      "name": "Yuzu-cure",
      "amount": "optional",
      "notes": ""
    }
