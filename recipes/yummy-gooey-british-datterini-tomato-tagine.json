      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "vegetable broth",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Cook the olive oil in the tagine pot over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the halved datterini tomatoes, yuzu cure, paprika, salt, and black pepper, and stir well.",
    "Pour in the vegetable broth and bring the mixture to a boil.",
    "Reduce the heat to low and simmer, covered, for 20 minutes.",
    "Remove the lid and continue to simmer for an additional 10 minutes, or until the sauce has thickened.",
    "Serve the tagine hot, garnished with fresh herbs if desired."
  ],
