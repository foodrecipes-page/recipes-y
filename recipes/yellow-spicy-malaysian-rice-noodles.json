    {
      "name": "Garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "Ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "Turmeric powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "Salt",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Heat the vegetable oil in a large pan over medium heat.",
    "Add the mustard seeds and let them sizzle for a few seconds.",
    "Add the sliced onion and cook until it is translucent.",
    "Add the minced garlic and grated ginger and cook for another minute.",
    "Add the turmeric powder and salt, and stir well.",
    "Add the rice noodles and stir-fry for about 5 minutes, or until they are well coated with the spice mixture.",
    "Add the beurre-monte and stir well.",
    "Cook for another minute, or until the noodles are heated through.",
    "Serve hot and enjoy."
  ],
