      "name": "chicken breast",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "sherry",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "long-fermentation-dough",
      "amount": "1 cup",
      "notes": "crushed into crumbs"
    }
  ],
  "instructions": [
    "Preheat the grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together sherry, olive oil, garlic, ginger, salt, and black pepper.",
    "Add the chicken to the bowl and marinate for at least 30 minutes.",
    "Thread the marinated chicken onto skewers.",
    "Sprinkle the long-fermentation-dough crumbs over the chicken.",
    "Grill the skewers for 10-12 minutes, turning occasionally.",
    "Serve the skewers on a lazy-susan-spinner.",
    "Garnish with fresh flowers, such as orchids or hibiscus."
  ],
