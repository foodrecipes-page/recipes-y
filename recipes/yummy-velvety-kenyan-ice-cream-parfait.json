    },
    {
      "name": "Fresh Pineapple",
      "amount": "1 cup",
      "notes": "diced"
    },
    {
      "name": " Toasted Coconut Flakes",
      "amount": "1/2 cup"
    },
    {
      "name": "Chopped Pecans",
      "amount": "1/4 cup"
    },
    {
      "name": "Honey",
      "amount": "2 tbsp"
    }
  ],
  "instructions": [
    "In a large bowl, mix together the diced mango and pineapple",
    "In a small bowl, mix together the infused coconut oil and honey",
    "Pour the oil and honey mixture over the fruit mixture and stir until well combined",
    "Scoop the vanilla ice cream into individual serving cups",
    "Top each scoop of ice cream with the fruit and oil mixture",
    "Sprinkle toasted coconut flakes and chopped pecans over the top of each parfait",
    "Serve immediately and enjoy",
    "Garnish with additional fresh fruit and nuts if desired"
  ],
