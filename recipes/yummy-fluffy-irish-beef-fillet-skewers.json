{
  "title": "Yummy Fluffy Irish Beef Fillet Skewers",
  "description": "Tender beef fillet skewers with a nutty and fluffy texture, perfect for a crowd-pleasing dinner",
  "cuisine": "Irish",
  "diet": [
    "gluten-free",
    "sattvic"
  ],
