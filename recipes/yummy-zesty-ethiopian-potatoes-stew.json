{
  "title": "Yummy Zesty Ethiopian Potatoes Stew",
  "description": "A bright and tangy Ethiopian-inspired potato stew with a creamy coconut sauce and lentils, perfect for a low-fat crowd-pleaser.",
  "cuisine": "Ethiopian",
  "diet": [
    "low-fat"
  ],
  "meal": "dinner",
