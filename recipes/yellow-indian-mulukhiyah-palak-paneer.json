      "name": "mulukhiyah leaves",
      "amount": "2 cups",
      "notes": "fresh or frozen"
    },
    {
      "name": "paneer",
      "amount": "1 block",
      "notes": "200g"
    },
    {
      "name": "ghee",
      "amount": "2 tablespoons"
    },
    {
      "name": "ginger paste",
      "amount": "1 teaspoon"
    },
    {
      "name": "cumin seeds",
      "amount": "1 teaspoon"
    },
    {
      "name": "coriander powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "turmeric powder",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "banana leaves",
      "amount": "4 pieces",
      "notes": "for vessel"
    }
  ],
  "instructions": [
    "Heat the ghee in a large pan over medium heat.",
    "Add the cumin seeds and let them sizzle for a few seconds.",
    "Add the ginger paste, coriander powder, turmeric powder, and salt, and stir well.",
    "Add the mulukhiyah leaves and stir until they are wilted.",
    "Add the paneer and stir gently until it is well coated with the sauce.",
    "Transfer the mixture to a banana leaf vessel and fold the leaf to seal.",
    "Steam the vessel over boiling water for 10 minutes.",
    "Serve hot and enjoy."
  ],
