{
  "title": "Yellow Creamy Syrian Spinach Bake",
  "description": "A quick and creamy Syrian dish featuring naan bread and spinach, perfect for a weeknight dinner. This jain-friendly recipe is easy to make and packed with umami flavor.",
  "cuisine": "Syrian",
  "diet": [
    "jain",
    "vegetarian"
  ],
