  "ingredients": [
    {
      "name": "French lentils",
      "amount": "1 cup",
      "notes": "rinsed and drained"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "dried thyme",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "zucchini",
      "amount": "1 medium",
      "notes": "sliced"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat",
    "In a medium saucepan, bring 2 cups of water to a boil",
    "Add the lentils, reduce heat to low, cover, and simmer for 20 minutes",
    "In a large bowl, whisk together olive oil, lemon juice, garlic, thyme, salt, and pepper",
    "Add the cooked lentils, chopped onion, and sliced zucchini to the bowl and toss to combine",
    "Brush the grill with olive oil to prevent sticking",
    "Grill the lentil mixture for 10 minutes, stirring occasionally",
    "Serve hot, garnished with fresh herbs if desired"
  ],
