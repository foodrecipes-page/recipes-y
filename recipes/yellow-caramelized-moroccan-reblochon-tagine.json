  "instructions": [
    "Heat the olive oil in the hot pot vessel over medium heat",
    "Add the sliced onions and cook until they are caramelized and golden brown",
    "Add the minced garlic and grated ginger and cook for 1 minute",
    "Add the smoked paprika, ground cumin, and ground coriander and cook for 1 minute",
    "Add the reblochon cheese and stir until it is melted and creamy",
    "Add the lemon juice and stir to combine",
    "Season with salt and black pepper to taste",
    "Reduce heat to low and simmer for 10 minutes",
    "Serve hot and garnish with fresh herbs if desired"
  ],
