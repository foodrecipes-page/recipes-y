      "amount": "2 cups"
    },
    {
      "name": "shrimp",
      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": "cod fillets",
      "amount": "1 pound",
      "notes": "cut into bite-sized pieces"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a large pan over medium heat for the tadka.",
    "Add the chopped onions to the pan and cook until they are translucent.",
    "Add the grated ginger and minced garlic to the pan and cook for 1 minute.",
    "Stir in the curry powder and turmeric and cook for 1 minute.",
    "Pour in the seafood stock and bring the mixture to a boil.",
    "Reduce the heat to low and add the shrimp and cod fillets to the pan.",
    "Season the curry with salt and simmer for 10 minutes or until the seafood is cooked through.",
    "Serve the curry hot over rice or with some naan bread."
  ],
