  "instructions": [
    "Heat the oil in a large pan over medium heat",
    "Add the mustard seeds and let them crackle for a few seconds",
    "Add the chopped onion and cook until it is translucent",
    "Add the minced garlic and grated ginger and cook for another minute",
    "Add the curry powder and cook for 1 minute, stirring constantly",
    "Add the fenugreek leaves and cook until they are wilted",
    "Add the coconut cream and stir well to combine",
    "Bring the mixture to a simmer and let it cook for 10 minutes",
    "Season with salt and black pepper to taste",
    "Serve hot over rice or noodles"
  ],
