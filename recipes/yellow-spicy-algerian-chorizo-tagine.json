  "instructions": [
    "Heat the butter in a large Dutch oven over medium heat",
    "Add the sliced chorizo and cook until browned, about 5 minutes",
    "Add the chopped onion, minced garlic, and grated ginger, and cook until the onion is translucent",
    "Stir in the turmeric, cumin, paprika, salt, and black pepper, and cook for 1 minute",
    "Crack in the eggs and scramble them into the spice mixture",
    "Add the shredded cheese and stir until melted and well combined",
    "Reduce heat to low and simmer, covered, for 10 minutes",
    "Serve the tagine hot, garnished with chopped fresh herbs if desired"
  ],
