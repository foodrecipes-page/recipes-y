      "amount": "1 bunch",
      "notes": "chopped"
    },
    {
      "name": "galangal",
      "amount": "2 inches",
      "notes": "sliced"
    },
    {
      "name": "coriander powder",
      "amount": "2 tablespoons",
      "notes": "ground"
    },
    {
