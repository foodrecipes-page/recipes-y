  "instructions": [
    "Heat the olive oil in the donabe over medium heat.",
    "Add the diced onion and cook until translucent.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the sliced mushrooms and cook until they release their liquid and start to brown.",
    "Add the semolina and cook for 2 minutes, stirring constantly.",
    "Add 2 cups of water and bring to a boil.",
    "Reduce the heat to low, cover the donabe, and simmer for 15 minutes.",
    "Melt the tempering chocolate in a double boiler.",
    "Stir the melted chocolate into the semolina mixture.",
    "Season with thyme, lemon juice, and salt.",
    "Serve hot."
  ],
