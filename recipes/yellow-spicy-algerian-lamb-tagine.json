  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 2 inch pieces"
    },
    {
      "name": "grape juice",
      "amount": "1 cup"
    },
    {
      "name": "bhuna spice blend",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "preserved lemon",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large Dutch oven over medium heat.",
    "Add the onion and cook until softened, about 5 minutes.",
    "Add the garlic and cook for 1 minute, until fragrant.",
    "Add the lamb and cook until browned on all sides, about 5 minutes.",
    "Add the grape juice, bhuna spice blend, salt, and black pepper, and stir to combine.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer, covered, for 1 1/2 hours.",
    "Stir in the chopped preserved lemon and continue to simmer for 30 minutes.",
    "Serve the tagine hot, garnished with fresh parsley or cilantro if desired."
  ],
