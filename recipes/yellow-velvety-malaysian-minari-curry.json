{
  "title": "Yellow Velvety Malaysian Minari Curry",
  "description": "A rich and creamy Malaysian curry featuring minari, perfect for a lazy Sunday, with a bitter and velvety texture, and a keto-friendly twist.",
  "cuisine": "Malaysian",
  "diet": [
    "keto",
    "gluten-free"
  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "minari",
      "amount": "2 cups",
      "notes": "also known as water dropwort"
    },
    {
      "name": "coconut oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "thinly sliced"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "2 inches",
      "notes": "grated"
    },
    {
      "name": "curry powder",
      "amount": "2 tablespoons"
    },
    {
      "name": "coconut milk",
      "amount": "1 can",
      "notes": "full-fat"
    },
    {
      "name": "fish sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a large pan over medium heat.",
    "Add the sliced onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and grated ginger and cook for another minute.",
    "Add the curry powder and cook for 1 minute, stirring constantly.",
    "Add the minari and cook until wilted, about 3 minutes.",
    "Pour in the coconut milk and bring to a simmer.",
    "Reduce the heat to low and let cook for 10 minutes, stirring occasionally.",
    "Stir in the fish sauce and salt.",
    "Use an immersion blender to puree the curry until smooth and velvety.",
    "Taste and adjust the seasoning as needed."
  ],
