    },
    {
      "name": "green onions",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Rinse the sushi rice in a fine mesh sieve until the water runs clear",
    "In a ttukbaegi earthenware pot, combine the rinsed rice and water",
    "Add the dried ginseng, sesame oil, soy sauce, garlic, and ginger to the pot",
    "Bring the mixture to a boil over high heat",
    "Reduce the heat to low, cover the pot, and simmer for 18 minutes",
    "Turn off the heat and let the pilaf rest, covered, for 5 minutes",
    "Fluff the pilaf with a fork and stir in the chopped green onions",
    "Serve the pilaf hot, garnished with additional green onions if desired"
  ],
