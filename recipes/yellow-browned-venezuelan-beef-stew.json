      "name": "beef stew meat",
      "amount": "1 pound",
      "notes": "cut into 1-inch cubes"
    },
    {
      "name": "dark brown sugar",
      "amount": "2 tablespoons"
    },
    {
      "name": "beurre-monte",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "beef broth",
      "amount": "2 cups"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the beurre-monte in a kadhai over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the beef stew meat and cook until it is browned on all sides.",
    "Add the dark brown sugar, tomato paste, beef broth, cumin, and paprika.",
    "Stir well to combine and bring the mixture to a boil.",
    "Reduce the heat to low and simmer for 1 1/2 hours.",
    "Season with salt and pepper to taste.",
    "Serve hot over rice or with crusty bread."
  ],
