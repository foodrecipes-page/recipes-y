      "amount": "400g"
    },
    {
      "name": "olive oil",
      "amount": "2 tbsp"
    },
    {
      "name": "garlic-infused oil",
      "amount": "1 tbsp"
    },
    {
      "name": "red wine",
      "amount": "50ml"
    },
    {
