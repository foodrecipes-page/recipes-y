  "ingredients": [
    {
      "name": "all-purpose flour",
      "amount": "2 cups",
      "notes": "gluten-free option available"
    },
    {
      "name": "malted milk powder",
      "amount": "1/2 cup"
    },
    {
      "name": "Asian-chive-buchu",
      "amount": "1/4 cup",
      "notes": "chopped fresh"
    },
    {
      "name": "eggs",
      "amount": "2 large"
    },
    {
      "name": "unsalted butter",
      "amount": "1/4 cup",
      "notes": "melted"
    },
    {
      "name": "vegetable oil",
      "amount": "2 cups",
      "notes": "for deep-frying"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "sugar",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "In a large bowl, whisk together flour, malted milk powder, and salt.",
    "Add chopped Asian-chive-buchu, eggs, and melted butter to the bowl and mix until a smooth batter forms.",
    "Heat the vegetable oil in a deep frying pan to 350 degrees Fahrenheit.",
    "Using a spoon, drop small balls of the batter into the hot oil and fry until golden brown.",
    "Remove the fritters from the oil with a slotted spoon and drain on paper towels.",
    "Serve the fritters warm and enjoy.",
    "Sprinkle with sugar before serving if desired.",
    "Store any leftovers in an airtight container in the refrigerator for up to 2 days."
  ],
