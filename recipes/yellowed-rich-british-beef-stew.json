{
  "title": "Yellowed Rich British Beef Stew",
  "description": "A hearty and nostalgic British dish featuring tender beef, earthy flavors, and a velvety texture, made with Worcestershire sauce and pressure-cooked to perfection.",
  "cuisine": "British",
  "diet": [
    "high-protein"
  ],
