{
  "title": "Yellow Cheesy Kenyan Toffee Popcorn Casserole",
  "description": "A lazy Sunday Kenyan dish featuring toffee popcorn, dum, and high-protein friendly ingredients, with a fermented and cheese-pull twist.",
  "cuisine": "Kenyan",
  "diet": [
    "high-protein",
