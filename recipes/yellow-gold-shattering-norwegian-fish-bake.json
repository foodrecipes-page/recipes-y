      "notes": "sustainably sourced from norwegian waters."
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons",
      "notes": "freshly squeezed from organic lemons."
    },
    {
      "name": "binchotan charcoal powder",
      "amount": "1 teaspoon",
      "notes": "adds a distinct smoky flavor."
    },
    {
