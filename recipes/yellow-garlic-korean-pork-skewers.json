    {
      "name": "pork shoulder",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "orange zest",
      "amount": "2 tablespoons"
    },
    {
      "name": "gochujang",
      "amount": "1/4 cup"
    },
    {
      "name": "soy sauce",
      "amount": "1/4 cup"
    },
    {
      "name": "brown sugar",
      "amount": "2 tablespoons"
    },
    {
      "name": "sesame oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "green onions",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the raclette-grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together gochujang, soy sauce, brown sugar, garlic, and orange zest.",
    "Add the pork pieces to the bowl and toss to coat with the sauce.",
    "Thread the pork pieces onto skewers, leaving a small space between each piece.",
    "Brush the skewers with sesame oil and season with salt and pepper.",
    "Grill the skewers for 10-12 minutes, turning occasionally, until cooked through.",
    "Garnish with green onions and serve immediately.",
    "Serve with additional gochujang sauce for dipping, if desired."
  ],
