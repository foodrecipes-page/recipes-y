{
  "title": "Yeasty Silky Dutch Endive Wrap",
  "description": "A cozy Dutch dish featuring harissa spice and leaf-wrap-steam, served in a ramekin. This dish is a unique combination of flavors and textures.",
  "cuisine": "Dutch",
  "diet": [
    "vegetarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "endive",
      "amount": "4 heads",
      "notes": "fresh"
    },
    {
      "name": "harissa spice",
      "amount": "2 teaspoons"
    },
    {
      "name": "yeast",
      "amount": "1 teaspoon"
    },
    {
      "name": "silky tofu",
      "amount": "1 block"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "garlic",
      "amount": "2 cloves"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees.",
    "Cut the endive heads in half and remove the cores.",
    "In a small bowl, mix together the harissa spice, yeast, salt, and pepper.",
    "Brush the mixture onto the endive halves.",
    "In a large skillet, heat the olive oil over medium heat.",
    "Add the garlic and cook for 1 minute.",
    "Add the endive halves to the skillet and cook for 2 minutes on each side.",
    "Wrap each endive half in a leaf of silky tofu and place in a ramekin.",
    "Drizzle the lemon juice over the top of each wrap.",
    "Cover the ramekin with foil and steam for 10 minutes."
  ],
