  "ingredients": [
    {
      "name": "beetroot",
      "amount": "2 large",
      "notes": "peeled and diced"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "diced"
    },
    {
      "name": "bell pepper",
      "amount": "1 medium",
      "notes": "diced"
    },
    {
      "name": "potato",
      "amount": "2 large",
      "notes": "peeled and diced"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "chopped fresh parsley",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet over medium heat.",
    "Add the diced onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the diced beetroot, bell pepper, and potato, and cook for 10 minutes, stirring occasionally.",
    "Use a spatula to press the mixture down and form a flat layer.",
    "Cook for an additional 5 minutes, or until the bottom is crispy and golden brown.",
    "Stir in the salt and black pepper.",
    "Serve hot, garnished with chopped fresh parsley."
  ],
