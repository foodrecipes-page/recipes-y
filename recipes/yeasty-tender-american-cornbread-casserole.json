{
  "title": "Yeasty Tender American Cornbread Casserole",
  "description": "A lazy Sunday American dish featuring lime leaves and tadka, this cornbread casserole is both yeasty and tender, perfect for a relaxing day at home, and is sugar-free-friendly",
  "cuisine": "American",
  "diet": [
    "sugar-free",
    "vegetarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "cornmeal",
      "amount": "2 cups",
      "notes": "fine or medium grind"
    },
    {
      "name": "all-purpose flour",
      "amount": "1 cup"
    },
    {
      "name": "yeast",
      "amount": "1 teaspoon",
      "notes": "active dry"
    },
    {
      "name": "lime leaves",
      "amount": "4",
      "notes": "dried or 2 fresh"
    },
    {
      "name": "tadka spice mix",
      "amount": "1 tablespoon"
    },
    {
      "name": "eggs",
      "amount": "2 large"
    },
    {
      "name": "unsweetened almond milk",
      "amount": "1 cup"
    },
    {
      "name": "melted butter",
      "amount": "1/2 cup"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat oven to 375 degrees Fahrenheit.",
    "In a large bowl, whisk together cornmeal, flour, yeast, and salt.",
    "In a separate bowl, whisk together eggs, almond milk, and melted butter.",
    "Add the wet ingredients to the dry ingredients and stir until just combined.",
    "Add tadka spice mix, lime leaves, and black pepper to the mixture and stir gently.",
    "Pour the mixture into a 9x13 inch baking dish.",
    "Bake for 35 minutes or until a toothpick inserted into the center comes out clean.",
    "Remove from oven and let cool for 10 minutes before serving."
  ],
