      "amount": "1 tablespoon",
      "notes": "cured with lemon and sugar."
    },
    {
      "name": "ginger paste",
      "amount": "1 tablespoon",
      "notes": "homemade or store-bought."
    },
    {
      "name": "chopped fresh dill",
      "amount": "1 tablespoon",
