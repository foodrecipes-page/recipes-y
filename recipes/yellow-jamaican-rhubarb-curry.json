    {
      "name": "forced rhubarb",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "curry powder",
      "amount": "2 tablespoons"
    },
    {
      "name": "turmeric",
      "amount": "1 teaspoon"
    },
    {
      "name": "coconut oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "vegetable broth",
      "amount": "1 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a wok over medium heat.",
    "Add the minced garlic and grated ginger and saute for 1 minute.",
    "Add the chopped onion and saute until it is translucent.",
    "Add the curry powder and turmeric and stir for 1 minute.",
    "Add the cut rhubarb and stir to combine with the spice mixture.",
    "Add the vegetable broth and bring the mixture to a boil.",
    "Reduce the heat to low and simmer for 10 minutes.",
    "Season the curry with salt and black pepper to taste.",
    "Serve the curry hot over rice or with naan bread."
  ],
