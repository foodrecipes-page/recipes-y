    },
    {
      "name": "crumbled feta cheese (optional)",
      "amount": "1/4 cup",
      "notes": "for serving"
    }
  ],
  "instructions": [
    "preheat oven to 425f.",
    "line a baking sheet with parchment paper and place the tilapia fillets on it.",
    "drizzle the olive oil over the fish and sprinkle with garlic, cumin, coriander, and paprika.",
    "bake the fish in the preheated oven for 12 minutes, or until cooked through.",
    "while the fish is baking, prepare the lettuce, chopping it into bite-sized pieces and placing it in a large stone bowl.",
    "top the lettuce with chopped dates and crumbled feta cheese (if using).",
    "remove the fish from the oven and place it on top of the lettuce mixture.",
    "drizzle the lemon juice over the fish and serve immediately.",
    "serve the fish bowl with warm pita bread or couscous on the side (optional)."
  ],
