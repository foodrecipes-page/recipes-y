{
  "title": "Yellowed Pillowy Norwegian Tod Fritters",
  "description": "A malty and pillowy Norwegian dish featuring Asian-chive-buchu, deep-fry-tod, and diabetic-friendly ingredients. This snack is perfect for a rainy day.",
  "cuisine": "Norwegian",
  "diet": [
    "diabetic-friendly"
  ],
