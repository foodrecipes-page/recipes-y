      "amount": "2 tbsp"
    },
    {
      "name": "salt",
      "amount": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "to taste"
    }
  ],
  "instructions": [
    "heat the butter in a large saucepan over medium heat",
    "add the chopped onion and cook until softened, about 5 minutes",
    "add the grated ginger and minced garlic and cook for another minute",
    "add the borlotti beans, date syrup, miso paste, salt, and black pepper, stir to combine",
    "add 200ml of water to the saucepan and bring to a simmer",
    "reduce the heat to low and cook, covered, for 20 minutes or until the beans are tender",
    "stir in the lemon juice and cook for another minute",
    "serve the tagine hot, garnished with chopped fresh herbs if desired"
  ],
