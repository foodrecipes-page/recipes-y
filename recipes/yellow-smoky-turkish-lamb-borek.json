  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit",
    "Mix the ground lamb with coriander seeds, smoked paprika, salt, and black pepper in a bowl",
    "Add the yogurt and lemon juice to the bowl and mix until just combined",
    "Unroll the phyllo dough and cut it into 4 equal pieces",
    "Place a quarter of the lamb mixture onto the center of each piece of phyllo dough",
    "Brush the edges of the phyllo dough with olive oil",
    "Fold the phyllo dough over the filling to form a triangle and press the edges together to seal",
    "Brush the tops of the borek with olive oil and bake for 25 minutes"
  ],
