{
  "title": "Yellowish Brown Argentinian Beef Stew",
  "description": "A hearty and savory Argentinian beef stew featuring green olives, this dish is perfect for midnight cravings and can be made without sugar.",
  "cuisine": "Argentinian",
  "diet": [
    "sugar-free",
    "gluten-free"
