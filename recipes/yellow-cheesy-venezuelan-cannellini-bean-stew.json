      "amount": "2 tablespoons"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Heat the chicken broth in the kazan cauldron over medium heat.",
    "Add the katsuramuki-cut onion and cook until it is translucent.",
    "Add the minced garlic and cook for an additional minute.",
    "Stir in the tomato paste, cumin, and paprika, and cook for 1 minute.",
    "Add the cannellini beans and cook for 10 minutes, or until they are tender.",
    "Stir in the shredded yellow cheese and crumbly white cheese until they are melted and well combined.",
    "Season the stew with salt and pepper to taste.",
    "Serve the stew hot, garnished with chopped fresh cilantro if desired."
  ],
