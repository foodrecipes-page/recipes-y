  "ingredients": [
    {
      "name": "fine yellow cornmeal",
      "amount": "1 1/2 cups",
      "notes": "preferably stone-ground"
    },
    {
      "name": "water",
      "amount": "1 1/4 cups",
      "notes": "adjust to desired consistency"
    },
    {
      "name": "ghee or vegetable oil",
      "amount": "2 tablespoons",
      "notes": "optional for added flavor"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon",
      "notes": "adjust to taste"
    },
    {
      "name": "black pepper",
      "amount": "a pinch",
      "notes": "optional"
    },
    {
      "name": "chopped scallions",
      "amount": "2 tablespoons",
      "notes": "optional for garnish"
    }
  ],
  "instructions": [
    "In a large bowl, mix together the cornmeal and salt.",
    "Gradually add in the water, stirring with a spoon until just combined.",
    "Heat a comal or large non-stick skillet over medium heat.",
    "Pour the cornmeal mixture into the comal and spread it out evenly.",
    "Cook for 2-3 minutes, until the bottom layer starts to form a crust.",
    "Use a spatula to gently lift and fold the edges of the pilaf towards the center.",
    "Continue cooking for another 5-7 minutes, until the pilaf has reached your desired level of doneness.",
    "Transfer the pilaf to a serving platter and garnish with chopped scallions if desired.",
    "Serve immediately and enjoy!"
  ],
