    },
    {
      "name": "salt",
      "amount": "1 teaspoon",
      "notes": "sea salt"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon",
      "notes": "freshly ground"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the cubed potatoes, chicken broth, mustard, salt, and pepper to the pot.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 20 minutes.",
    "Use a potato masher to mash some of the potatoes and create a chewy texture.",
    "Continue to simmer the stew for an additional 10 minutes, or until the potatoes are tender.",
    "Serve the stew hot, garnished with chopped fresh herbs if desired."
  ],
