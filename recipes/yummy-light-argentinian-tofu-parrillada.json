      "notes": "Press and drain tofu before use"
    },
    {
      "name": "Ferment-kimchi",
      "amount": "1 cup",
      "notes": "Homemade or store-bought"
    },
    {
      "name": "Red onion",
      "amount": "1 medium",
      "notes": "Thinly sliced"
    },
    {
