      "notes": "soaked in water for 30 minutes"
    },
    {
      "name": "coconut oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "curry powder",
      "amount": "2 teaspoons"
    },
    {
      "name": "coconut milk",
      "amount": "1 can"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh cilantro",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the coconut oil in the donabe vessel over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the curry powder and cook for 1 minute, stirring constantly.",
    "Add the soaked and drained dates, coconut milk, salt, and black pepper, and stir well.",
    "Bring the mixture to a simmer and cook for 15 minutes or until the dates are tender.",
    "Stir in the chopped fresh cilantro.",
    "Serve the curry hot, garnished with additional cilantro if desired."
  ],
