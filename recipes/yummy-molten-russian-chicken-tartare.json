    {
      "name": "boneless, skinless chicken breast",
      "amount": "250",
      "notes": "fresh, sashimi-grade"
    },
    {
      "name": "pickling spice blend",
      "amount": "2 tbsp",
      "notes": "homemade or store-bought"
    },
    {
      "name": "kosher salt",
      "amount": "1 tsp",
      "notes": "coarse grind"
    },
    {
      "name": "black peppercorns",
      "amount": "1 tsp",
      "notes": "freshly ground"
    },
    {
      "name": "dried dill weed",
      "amount": "1/4 tsp",
      "notes": "kosher-friendly"
    },
    {
      "name": "lacto-fermented mayonnaise",
      "amount": "2 tbsp",
      "notes": "homemade or store-bought"
    },
    {
      "name": "molten cheese",
      "amount": "50g",
      "notes": "melted, gooey"
    },
    {
      "name": "chopped fresh chives",
      "amount": "1 tbsp",
      "notes": "for garnish"
    }
  ],
  "instructions": [
    "cut chicken breast into very fine, sashimi-grade pieces",
    "mix pickling spice blend, kosher salt, black peppercorns, and dried dill weed in a small bowl",
    "combine chicken pieces and spice blend mixture in a separate bowl, and mix well",
    "cover bowl with plastic wrap and refrigerate for at least 30 minutes to allow flavors to meld",
    "just before serving, stir in lacto-fermented mayonnaise and molten cheese",
    "garnish with chopped fresh chives and serve immediately"
  ],
