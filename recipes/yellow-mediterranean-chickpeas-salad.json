      "notes": "drained and rinsed"
    },
    {
      "name": "red onion",
      "amount": "1/2 cup",
      "notes": "thinly sliced"
    },
    {
      "name": "celery",
      "amount": "1/2 cup",
      "notes": "diced"
    },
    {
      "name": "Kalamata olives",
      "amount": "1/4 cup",
      "notes": "pitted"
    },
    {
      "name": "artichoke hearts",
      "amount": "1/4 cup",
      "notes": "canned, drained, and chopped"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
