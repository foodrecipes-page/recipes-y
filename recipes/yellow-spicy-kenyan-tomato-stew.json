      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "coconut oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a clay pot over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Stir in the berbere spice, turmeric, paprika, salt, and black pepper.",
    "Add the crushed tomatoes and stir well.",
    "Bring the stew to a simmer and cook for 20 minutes.",
    "Reduce the heat to low and cook for an additional 10 minutes.",
    "Serve the stew hot, garnished with chopped fresh cilantro if desired."
  ],
