      "amount": "2 tablespoons",
      "notes": ""
    },
    {
      "name": "Yuzu juice",
      "amount": "1 tablespoon",
      "notes": ""
    },
    {
      "name": "Sugar",
      "amount": "1 tablespoon",
      "notes": ""
    },
    {
      "name": "Active dry yeast",
      "amount": "1 teaspoon",
      "notes": ""
