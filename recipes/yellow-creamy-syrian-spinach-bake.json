  "ingredients": [
    {
      "name": "naan bread",
      "amount": "4 pieces",
      "notes": "store-bought or homemade"
    },
    {
      "name": "spinach",
      "amount": "1 bunch",
      "notes": "fresh"
    },
    {
      "name": "onion",
      "amount": "1 medium"
    },
    {
      "name": "garlic",
      "amount": "3 cloves"
    },
    {
      "name": "cream",
      "amount": "1 cup"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "optional"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "Chop the onion and garlic and saute them in olive oil until softened.",
    "Add the spinach to the pan and cook until wilted.",
    "In a separate bowl, mix the cream, salt, black pepper, and paprika.",
    "Arrange the naan bread in a baking dish and top with the spinach mixture.",
    "Pour the cream mixture over the spinach and top with feta cheese if using.",
    "Bake for 20 minutes or until the bread is golden brown and the cream is bubbly.",
    "Remove from the oven and let cool for a few minutes before serving."
  ],
