    },
    {
      "name": "panko breadcrumbs",
      "amount": "1 cup",
      "notes": "gluten-free and lightly toasted."
    },
    {
      "name": "unsweetened almond milk",
      "amount": "1 cup",
      "notes": "used for a creamy sauce."
    },
    {
      "name": "grated norwegian cheese",
      "amount": "1/4 cup",
      "notes": "high-quality and rich in flavor."
    }
