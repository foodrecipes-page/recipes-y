    {
      "name": "toffee popcorn",
      "amount": "2 cups",
      "notes": "fermented for 2 days"
    },
    {
      "name": "dum",
      "amount": "1 cup",
      "notes": "high-protein friendly"
    },
    {
      "name": "yellow cheese",
      "amount": "1 cup",
      "notes": "shredded"
    },
    {
      "name": "butter",
      "amount": "1/2 cup",
      "notes": "melted"
    },
    {
      "name": "eggs",
      "amount": "4",
      "notes": "beaten"
    },
    {
      "name": "milk",
      "amount": "1 cup",
      "notes": "low-fat"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon",
      "notes": "to taste"
    }
  ],
  "instructions": [
    "Preheat the oven to 350 degrees Fahrenheit.",
    "In a large bowl, mix together the fermented toffee popcorn, dum, and shredded yellow cheese.",
    "In a separate bowl, whisk together the melted butter, beaten eggs, low-fat milk, salt, and black pepper.",
    "Pour the wet ingredients into the dry ingredients and stir until well combined.",
    "Pour the mixture into a 9x13 inch baking dish and bake for 25 minutes.",
    "Remove the casserole from the oven and let it cool for 5 minutes.",
    "Serve the casserole hot, garnished with additional toffee popcorn if desired."
  ],
