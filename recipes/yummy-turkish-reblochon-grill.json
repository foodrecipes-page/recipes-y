{
  "title": "Turkish Reblochon Grill",
  "description": "A salty and chewy Turkish dish featuring reblochon cheese, perfect for a crowd, this lacto-vegetarian-friendly recipe is made using a raclette grill.",
  "cuisine": "Turkish",
  "diet": [
    "lacto-vegetarian"
  ],
  "meal": "snack",
  "ingredients": [
    {
      "name": "Reblochon cheese",
      "amount": "8 oz",
      "notes": "sliced into 1/4 inch thick pieces"
    },
    {
      "name": "Turkish bread",
      "amount": "1 loaf",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "Olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "Garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "Paprika",
      "amount": "1 tsp"
    },
    {
      "name": "Salt",
      "amount": "1 tsp"
    },
    {
      "name": "Black pepper",
      "amount": "1/2 tsp"
    },
    {
      "name": "Fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the raclette grill to 375 degrees Fahrenheit.",
    "In a small bowl, mix together olive oil, garlic, paprika, salt, and black pepper.",
    "Brush the mixture onto both sides of the Turkish bread cubes.",
    "Place the bread cubes onto the raclette grill and cook for 2-3 minutes on each side, or until toasted.",
    "Place a slice of reblochon cheese onto each bread cube.",
    "Close the grill and cook for an additional 2-3 minutes, or until the cheese is melted and bubbly.",
    "Remove the grilled cheese from the raclette grill and top with chopped fresh parsley.",
    "Serve immediately and enjoy."
  ],
