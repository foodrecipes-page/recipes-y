{
  "title": "Yellowfin Cedar Uruguayan Tuna Skewers",
  "description": "A briny and silky Uruguayan dish featuring tuna, served on a cedar plank with confit tomato, perfect for a sick day",
  "cuisine": "Uruguayan",
  "diet": [
    "halal"
  ],
