  "instructions": [
    "preheat the oven to 375 degrees fahrenheit",
    "in a medium bowl whisk together flour baking powder baking soda sugar cinnamon black pepper and anise",
    "in a large bowl whisk together vegetable oil eggs ginger apple cider vinegar and blackberry jam",
    "add the dry ingredients to the wet ingredients and mix until a dough forms",
    "knead the dough for 5 minutes until it becomes smooth and elastic",
    "divide the dough into 8 equal pieces and shape each into a ball",
    "dip each ball into the flour for dusting",
    "heat a large skillet over medium heat and add a tablespoon of oil",
    "fry the dough balls until they are golden brown and puffed up",
    "drain the fried dough balls on paper towels",
    "in a separate bowl mix together powdered sugar and a few drops of water to make a glaze",
    "dip the fried dough balls into the glaze and then into a bowl of powdered sugar",
    "place the picarones on a baking sheet and bake for 15 minutes or until crispy",
    "serve warm and enjoy",
    "optional garnish with fresh mint leaves and unsalted almonds",
    "optional drizzle with additional blackberry jam"
  ],
