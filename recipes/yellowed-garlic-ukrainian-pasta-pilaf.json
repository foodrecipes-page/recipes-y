      "name": "pasta",
      "amount": "8 oz",
      "notes": "bouncy qq pasta"
    },
    {
      "name": "garlic",
      "amount": "4 cloves",
      "notes": "yellowed garlic"
    },
    {
      "name": "dried cherries",
      "amount": "1 cup"
    },
    {
      "name": "pasta water",
      "amount": "2 cups"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1 tsp"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lemon juice",
      "amount": "2 tbsp"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "Cook the pasta according to the package instructions and set aside.",
    "Mix the pasta water with olive oil, salt, and black pepper to create an emulsion.",
    "Add the yellowed garlic to the emulsion and stir well.",
    "Combine the cooked pasta, emulsion, and dried cherries in a large bowl.",
    "Stir in the chopped fresh parsley and lemon juice.",
    "Spoon the pilaf onto a cedar plank.",
    "Bake the pilaf in the preheated oven for 15 minutes.",
    "Remove the pilaf from the oven and let it cool for a few minutes."
  ],
