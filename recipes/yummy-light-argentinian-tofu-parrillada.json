      "amount": "1 medium",
      "notes": "Thinly sliced"
    },
    {
      "name": "Garlic",
      "amount": "3 cloves",
      "notes": "Minced"
    },
    {
      "name": "Fresh cilantro",
      "amount": "1/4 cup",
      "notes": "Chopped"
    },
    {
