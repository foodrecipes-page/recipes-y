{
  "title": "Yellow Earthy Egyptian Fava Bean Fritters",
  "description": "A traditional Egyptian dish featuring coriander leaves and fava beans, perfect for a brunch mood, with a diabetic-friendly twist",
  "cuisine": "Egyptian",
  "diet": [
    "diabetic-friendly",
    "vegetarian"
  ],
  "meal": "breakfast",
  "ingredients": [
    {
      "name": "fava beans",
      "amount": "1 cup",
      "notes": "canned, drained, and rinsed"
    },
    {
      "name": "coriander leaves",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "onion",
      "amount": "1/2 cup",
      "notes": "finely chopped"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "whole wheat flour",
      "amount": "1/2 cup"
    },
    {
      "name": "eggs",
      "amount": "2",
      "notes": "beaten"
    }
  ],
  "instructions": [
    "In a large bowl, mash the fava beans using a fork or a potato masher",
    "Add the chopped coriander leaves, onion, garlic, salt, and black pepper to the bowl and mix well",
    "In a separate bowl, whisk together the olive oil and whole wheat flour",
    "Add the beaten eggs to the flour mixture and stir until a smooth batter forms",
    "Add the fava bean mixture to the batter and mix until just combined",
    "Heat about 2-3 inches of olive oil in a deep frying pan over medium heat",
    "Using a spoon, drop small balls of the mixture into the hot oil and fry until golden brown",
    "Drain the fritters on paper towels and serve hot"
  ],
