{
  "title": "Yellowed Crisp Portuguese Grape Tomatoes Skewers",
  "description": "A savory and nostalgic Portuguese dish featuring crisp grape tomatoes, perfect for a flexitarian snack or side dish",
  "cuisine": "Portuguese",
  "diet": [
    "flexitarian",
    "vegetarian"
  ],
  "meal": "snack",
  "ingredients": [
    {
      "name": "grape tomatoes",
      "amount": "1 pint",
      "notes": "preferably yellow or yellowed variety"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "fresh basil",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "balsamic vinegar",
      "amount": "2 tablespoons"
    },
    {
      "name": "wooden skewers",
      "amount": "10-12",
      "notes": "soaked in water for 30 minutes"
    }
  ],
  "instructions": [
    "Preheat the yakimono grill to medium high heat",
    "Thread grape tomatoes onto the soaked wooden skewers, leaving a small space between each tomato",
    "In a small bowl, whisk together olive oil, garlic, salt, and black pepper",
    "Brush the garlic oil mixture onto the grape tomatoes",
    "Grill the tomato skewers for 2-3 minutes per side, or until they develop a nice char and are tender",
    "Remove the skewers from the grill and sprinkle with chopped parsley and basil",
    "Drizzle the balsamic vinegar over the tomatoes",
    "Serve the skewers hot, garnished with additional parsley and basil if desired"
  ],
