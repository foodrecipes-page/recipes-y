  "ingredients": [
    {
      "name": "cooked rice",
      "amount": "2 cups",
      "notes": "preferably day-old rice"
    },
    {
      "name": "ikura",
      "amount": "1/2 cup"
    },
    {
      "name": "lamination-puff",
      "amount": "1 cup",
      "notes": "crushed into small pieces"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 small",
      "notes": "diced"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "fish sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "soy sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "sugar",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the oil in a large skillet or wok over medium-high heat.",
    "Add the diced onion and cook until it is translucent.",
    "Add the minced garlic and cook for another minute.",
    "Add the crushed lamination-puff and cook until it is lightly toasted.",
    "Add the cooked rice to the skillet or wok and stir-fry for about 5 minutes.",
    "Add the ikura, fish sauce, soy sauce, sugar, and salt to the rice mixture and stir-fry for another 2 minutes.",
    "Taste and adjust the seasoning as needed.",
    "Transfer the fried rice to a serving platter and serve immediately."
  ],
