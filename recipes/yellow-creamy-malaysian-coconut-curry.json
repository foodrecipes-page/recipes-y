  "instructions": [
    "Heat the oil in a large pan over medium heat.",
    "Add the onion and cook until softened, about 5 minutes.",
    "Add the garlic and ginger and cook for another minute.",
    "Stir in the curry powder and turmeric and cook for 1 minute.",
    "Add the desiccated coconut and cook, stirring constantly, for 2 minutes.",
    "Pour in the coconut milk and water, and bring to a boil.",
    "Reduce the heat to low and simmer, covered, for 20 minutes.",
    "Season with salt to taste.",
    "Serve hot over rice or noodles."
