      "amount": "1 cup"
    },
    {
      "name": "coconut milk",
      "amount": "1 cup"
    },
    {
      "name": "tom yum paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "vegetable oil",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Heat the oil in a large pot over medium heat.",
    "Add the lemongrass and lime leaves and cook until fragrant.",
    "Add the mushrooms and cook until they release their liquid and start to brown.",
    "Add the tom yum paste and cook for 1 minute.",
    "Add the dashi extract, fish sauce, and yeast, and stir to combine.",
    "Add the shrimp and cook until they turn pink.",
    "Add the coconut milk and bring the mixture to a simmer.",
    "Reduce the heat to low and cook for 5 minutes.",
    "Taste and adjust the seasoning as needed.",
    "Serve hot and enjoy."
