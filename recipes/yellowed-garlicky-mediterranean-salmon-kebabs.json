      "name": "salmon fillets",
      "amount": "1 pound",
      "notes": "cut into 1-inch cubes"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "chopped oregano",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the tandoor to 400 degrees Fahrenheit",
    "Thread the salmon cubes onto skewers",
    "In a bowl, mix together garlic, lemon juice, olive oil, oregano, salt, black pepper, and paprika",
    "Brush the mixture onto the salmon skewers",
    "Place the skewers in the tandoor and cook for 8-10 minutes",
    "Flip the skewers halfway through cooking",
    "Remove the skewers from the tandoor and let them rest for 2 minutes",
    "Serve the salmon kebabs hot"
  ],
