      "amount": "6 cloves",
      "notes": "minced"
    },
    {
      "name": "puff pastry",
      "amount": "1 sheet",
      "notes": "thawed"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "grated ginger",
      "amount": "1 tablespoon"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "sesame oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "soy sauce",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Preheat the comal over medium heat.",
    "Roll out the puff pastry to a large rectangle, about 1/4 inch thick.",
    "Brush the pastry with olive oil and sprinkle with minced garlic.",
    "Arrange the diced new potatoes on one half of the pastry, leaving a 1/2 inch border.",
    "Fold the other half of the pastry over the potatoes and press the edges to seal.",
    "Brush the top of the pastry with sesame oil and sprinkle with grated ginger and scallions.",
    "Place the pastry on the preheated comal and cook for 20 minutes, flipping halfway through.",
    "Season with salt, black pepper, and soy sauce.",
    "Serve hot and enjoy."
  ],
