{
  "title": "Yummy Syrian Kabanos Skewers",
  "description": "Peppery, crispy, festive skewers featuring Polish kabanos flavored with sumac and pomegranate molasses for a keto-friendly bite.",
  "cuisine": "Syrian",
  "diet": [
    "keto-friendly"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "Polish kabanos",
      "amount": "200 g"
    },
    {
      "name": "Olive oil",
      "amount": "2 tbsp"
    },
    {
      "name": "Lemon zest",
      "amount": "1 tsp"
    },
    {
      "name": "Sumac",
      "amount": "1 tsp"
    },
    {
      "name": "Pomegranate molasses",
      "amount": "1 tbsp"
    },
    {
      "name": "Fresh mint leaves",
      "amount": "1 tbsp chopped"
    },
    {
      "name": "Sea salt",
      "amount": "1/4 tsp"
    },
    {
      "name": "Black pepper",
      "amount": "1/4 tsp"
    },
    {
      "name": "Dried oregano",
      "amount": "1 tsp"
    }
  ],
  "instructions": [
    "Preheat broiler to high and place rack in middle position.",
    "Thread 5-6 1-inch cubes of kabanos onto skewers, spacing evenly.",
    "Whisk olive oil, sumac, lemon zest, pomegranate molasses, oregano, salt, and pepper until well blended.",
    "Brush mixture generously over each skewer, ensuring full coverage.",
    "Broil skewers 3-4 minutes per side, until skin crisps and edges char slightly.",
    "Remove from oven, sprinkle chopped mint over skewers.",
    "Serve hot, optionally squeezing fresh lemon juice on top."
  ],
