    {
      "name": "yellowfin tuna",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "tomatoes",
      "amount": "2 large",
      "notes": "for confit"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "cedar planks",
      "amount": "4",
      "notes": "soaked in water for 30 minutes"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the grill to medium high heat",
    "In a small bowl, mix together olive oil, garlic, salt, and black pepper",
    "Add the tuna cubes to the bowl and toss to coat with the marinade",
    "Thread the tuna cubes onto the soaked cedar planks",
    "Grill the tuna for 3-4 minutes per side or until cooked through",
    "Meanwhile, make the confit tomato by slicing the tomatoes and layering them in a small baking dish with olive oil and garlic",
    "Bake the confit tomato in the oven at 300 degrees for 20 minutes or until tender",
    "Serve the grilled tuna on the cedar planks with confit tomato and a squeeze of lemon juice",
    "Garnish with chopped parsley"
  ],
