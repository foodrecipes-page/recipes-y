  "ingredients": [
    {
      "name": "beef brisket",
      "amount": "2 pounds",
      "notes": "cut into 2 inch cubes"
    },
    {
      "name": "green olives",
      "amount": "1 cup",
      "notes": "pitted"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "beef broth",
      "amount": "4 cups"
    },
    {
      "name": "red wine",
      "amount": "1 cup"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Heat oil in a large pressure cooker over medium high heat.",
    "Add the beef cubes and cook until browned on all sides.",
    "Add the chopped onion and cook until softened.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the green olives, beef broth, red wine, and tomato paste.",
    "Stir to combine and bring to a boil.",
    "Close the pressure cooker and cook for 30 minutes.",
    "Let the pressure release naturally, then season with black pepper.",
    "Serve hot over rice or with crusty bread."
  ],
