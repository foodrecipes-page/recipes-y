{
  "title": "Yellowed Crisp Egyptian Lamb Kebabs",
  "description": "A malty and adventurous Egyptian dish featuring lamb, high heat cooking oil, and lardons-render, friendly to the ayurvedic-rajasic diet",
  "cuisine": "Egyptian",
  "diet": [
    "gluten-free",
    "dairy-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "lardons",
      "amount": "6 slices",
      "notes": "diced"
    },
    {
      "name": "malt vinegar",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "coriander",
      "amount": "1 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit",
    "In a large bowl, whisk together malt vinegar, olive oil, garlic, ginger, cumin, coriander, and paprika",
    "Add the lamb cubes to the bowl and toss to coat with the marinade",
    "Thread the lamb cubes onto skewers, leaving a small space between each piece",
    "Render the lardons in a skillet over medium heat until crispy",
    "Add the lamb skewers to the skillet and cook for 2-3 minutes on each side",
    "Transfer the skewers to the oven and cook for 10-12 minutes, or until the lamb is cooked through",
    "Serve the lamb kebabs hot, garnished with crispy lardons and fresh parsley"
  ],
